{
    "name": "umbra-client",
    "version": "1.0.0",
    "description": "Client for the DMXControl 3 Software",
    "main": "dist/index.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "nodemon --exec 'ts-node' src/index.ts",
        "proto:generate": "mkdir -p src/generated && npx protoc --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/generated --ts_proto_opt=esModuleInterop=true,forceLong=string,outputServices=grpc-js -I=protos/dmxc-types $(find protos/dmxc-types -name \"*.proto\")",
        "build": "npm run proto:generate && tsc"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SvenFinn/umbra-client.git"
    },
    "author": "Sven Finn",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/SvenFinn/umbra-client/issues"
    },
    "homepage": "https://github.com/SvenFinn/umbra-client#readme",
    "devDependencies": {
        "@types/node": "^24.6.0",
        "nodemon": "^3.1.10",
        "protoc": "^32.1.0",
        "ts-node": "^10.9.2",
        "ts-proto": "^2.7.7",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "@grpc/grpc-js": "^1.14.0"
    }
}
